{
  "name": "make-theme",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "watch:style": "npx tailwindcss -i ./wp-content/themes/dan-taylor/assets/css/style.css -o ./wp-content/themes/dan-taylor/style.css --watch",
    "watch:js": "esbuild wp-content/themes/dan-taylor/assets/js/main.js --bundle --outfile=wp-content/themes/dan-taylor/assets/js/dist/main.min.js --watch",
    "build:style": "npx tailwindcss -i ./wp-content/themes/dan-taylor/assets/css/style.css -o ./wp-content/themes/dan-taylor/style.css --minify",
    "build:js": "esbuild wp-content/themes/dan-taylor/assets/js/main.js --bundle --minify --outfile=wp-content/themes/dan-taylor/assets/js/dist/main.min.js",
    "wplint": "composer run format && composer run lint",
    "build": "run-s \"build:*\"",
    "prepare": "husky"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@_tw/typography": "^0.5.17",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@tailwindcss/cli": "^4.0.14",
    "esbuild": "^0.25.0",
    "husky": "^9.0.11",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.7"
  }
}